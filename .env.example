# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
#
# Every key the project will ever need is listed here, grouped by the phase
# that introduces it, so a missing variable is a lookup instead of a hunt.
# You will also type these into the Render and Vercel dashboards in Phase 6.
# ---------------------------------------------------------------------------


# === SERVER =================================================================
# These stay on the server. They are never sent to the browser.

# --- Phase 1: server basics ---
PORT=5000
NODE_ENV=development
# Origin allowed by CORS. In production this becomes your Vercel URL.
CLIENT_ORIGIN=http://localhost:5173

# --- Phase 2: database ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/text-to-learn?retryWrites=true&w=majority
MONGO_URI=

# --- Phase 3: AI generation ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model ids live here, never hardcoded in source, so Phase 3 and Phase 12
# provably use the same model. Check what your key can reach at /v1/models.
OPENAI_TEXT_MODEL=

# --- Phase 10: Hinglish audio ---
OPENAI_TTS_MODEL=

# --- Phase 8: Auth0 (server side — token verification) ---
AUTH0_ISSUER=
AUTH0_AUDIENCE=

# --- Phase 9: YouTube Data API v3 ---
# Server-side only. See the warning below about VITE_ before you move this.
YOUTUBE_API_KEY=


# === CLIENT =================================================================
# !!! EVERYTHING BELOW IS PUBLIC !!!
#
# Vite inlines any variable prefixed with VITE_ directly into the JavaScript
# bundle it ships to the browser. Anyone can read them with View Source.
# They are configuration, not secrets.
#
# OPENAI_API_KEY and YOUTUBE_API_KEY must NEVER be given a VITE_ prefix.
# The browser talks to our server; our server talks to OpenAI and YouTube.
# That indirection is the only thing keeping the keys private.
#
# These belong in client/.env (a separate file), not in the root .env.
# ---------------------------------------------------------------------------

# --- Phase 5: talking to our own backend ---
# VITE_API_URL=http://localhost:5000

# --- Phase 8: Auth0 (browser side — starting the login redirect) ---
# The Auth0 client id is public by design; it identifies the app, it does not
# authorise anything on its own.
# VITE_AUTH0_DOMAIN=
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=
